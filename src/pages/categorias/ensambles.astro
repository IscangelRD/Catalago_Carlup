---
import ProductCard from "../../components/ProductCard.astro"
import Header from "../../components/Header.astro";

const generateWhatsAppLink = (phone: string, title: string) => {
  return `https://wa.me/${phone}?text=${encodeURIComponent(
    `Me interesa el producto ${title}`
  )}`;
};


const products = [
  {
    image: '/images_carlup_old/sueter3.jpg',
    title: 'Suéter de lana',
    description: 'Suéter cálido y cómodo para el invierno.',
    whatsappLink:generateWhatsAppLink("7751304983","Modelo 131"),
  },
  {
    image: '/images/sueter3.jpg',
    title: 'Ensamble casual',
    description: 'Perfecto para eventos semi-formales.',
    whatsappLink: generateWhatsAppLink("7751182935","Modelo 136") 
  },
];
---
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">


<Header></Hader>

<div class="product-grid">
  {products.map(product => (
    <ProductCard {...product} />
  ))}
</div>


<style>
  .product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
  padding: 16px;
}

</style>


